# Copy this file to .env and fill in your values
# Never commit .env to git

# From discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here

# From discord.com/developers/applications -> your app -> General Information -> Application ID
APPLICATION_ID=your_application_id_here

# Right-click your Discord server name -> Copy Server ID (requires Developer Mode enabled)
SERVER_ID=your_server_id_here

# Discord user ID for the admin/owner who can override picks and receives coverage and delivery-failure alerts
ADMIN_DISCORD_ID=your_discord_user_id_here

# Discord channel ID where mid-month reminders are posted
REMINDER_CHANNEL_ID=your_reminder_channel_id_here

# Hour of day (0-23) for mid-month reminders (uses server's local timezone)
REMINDER_HOUR=10
